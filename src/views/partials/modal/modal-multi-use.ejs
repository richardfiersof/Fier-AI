<div class="modal fade" id="<%= modalId _%>" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
  <div class="modal-dialog <%= modalSize _%> ">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%= modalTitle _%></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

      </div>

      <div class="modal-body">
        <form id="<%= modalForm _%>">

          <div class="row <%= modalRowCols _%>">
            <%_ for (const data of modalData) { _%>
              <%_ if ( data.type === "input") { _%>
                  <%_ if ( data.dataType === "checkbox") { _%>
                    <div class="col<%= data.row ? '-'+data.row : '' _%>" id="div<%= data.nome _%>">
                        <div class="form-group custom-control custom-switch">
                          <input type="checkbox" class="custom-control-input" id="<%= data.nome _%>" <%= data.atritubos _%>>
                          <label class="custom-control-label" for="<%= data.nome _%>"><%= data.titulo _%></label>
                        </div>
                    </div>
                  <%_ } else { _%>   
                    <div class="col<%= data.row ? '-'+data.row : '' _%>" id="div<%= data.nome _%>">
                        <div class="form-group" >
                          <label for="<%= data.nome _%>"><%= data.titulo _%></label>
                          <input type="<%= data.dataType _%>"  class="form-control form-control-sm" name="<%= data.nome _%>" autocomplete="nope" autocomplete="off" id="<%= data.nome _%>" <%= data.atritubos _%>>
                          <%_ if(  data.atritubos[0] !== undefined){ _%>
                              <%_ if( data.atritubos[0].includes('list')) {_%>
                                <datalist id="<%= data.list _%>" name="<%= data.list _%>" autocomplete="nope" autocomplete="off" ></datalist>
                              <%_ } _%>
                          <%_ } _%>   
                        </div>
                    </div>
                  <%_ } _%>   
              <%_ } else if ( data.type === "textarea" ){ _%>
                  <div class="col<%= data.row ? '-'+data.row : '' _%>" id="div<%= data.nome _%>">
                    <div class="form-group" >
                        <label for="<%= data.nome _%>"><%= data.titulo _%></label>
                        <textarea id="<%= data.nome _%>" class="form-control form-control-sm" <%= data.atritubos _%>></textarea>
                    </div>
                  </div>
              <%_ } else if ( data.type === "select") { _%>
                  <div class="col<%= data.row ? '-'+data.row : '' _%>" id="div<%= data.nome _%>">
                    <div class="form-group" >
                        <label for="<%= data.nome _%>"><%= data.titulo _%></label>
                        <select id="<%= data.nome _%>" class="form-control form-control-sm" <%= data.atritubos _%>>
                          <%_ for (const opt of data.opcoes) { _%>
                              <option value="<%= opt.valor%>" > <%= opt.nome _%></option>
                          <%_ } _%>
                        </select>
                    </div>
                  </div>
              <%_ } else if ( data.type ==="datalist") { _%>
                  <div class="col<%= data.row ? '-'+data.row : '' _%>" id="div<%= data.nome _%>">
                    <div class="form-group" >
                        <label for="<%= data.nome _%>"><%= data.titulo _%></label>
                        <input id="<%= data.nome _%>" class="form-control form-control-sm" <%- data.atritubos %>>
                        <datalist id="<%= data.datalist _%>"  name="<%= data.datalist _%>" autocomplete="nope" autocomplete="off" >
                          <%_ if(data.opcoes.length >0) { _%>
                              <%_ for (const opt of data.opcoes) { _%>
                                <option value="<%= opt.valor%>" > <%= opt.nome %></option>
                              <%_ } _%>
                          <%_ } _%>   
                        </datalist>
                    </div>
                  </div>
              <%_ } else { _%>
                  <div class="col<%= data.row ? '-'+data.row : '' _%>" id="div<%= data.nome _%>">
                  <div class="form-group" >
                    <<%-data.type%> id="<%= data.nome _%>" <%= data.atritubos _%>> <%= data.titulo _%> </<%-data.type _%>>
                  </div>
            </div>
            <%_ } _%>
          <%_ } _%>
          </div>
          <div id="modal<%= modalId _%>Outros"></div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn col btn-primary btn-sm" id="<%= modalBtn _%>">Confirmar</button>
        <button type="button" class="btn col btn-danger btn-sm" data-bs-dismiss="modal">Fechar</button>
      </div>
    </div>
  </div>
</div>