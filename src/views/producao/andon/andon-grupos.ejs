<%- include("../../partials/headers/start-header.ejs") _%>
<%- include("../../partials/headers/import-padrao-header.ejs") _%>
<%- include("../../partials/headers/end-header.ejs") _%>

<div class="container-fluid mainItem">
  <div class="card text-center">
    <div class="card-header fs-3"><%- sysTitle _%></div>
    <div class="card-body">
      <%_ if (locals.grupos.length >0){ _%>
        <ul class="list-group">
        <a href="<%= sys.replace(":grupoId","todos") _%>" class="list-group-item list-group-item-action">Todos</a>
        <%_ for ( const { id, descricao } of grupos) { _%>
          <a href="<%= sys.replace(":grupoId",id) _%>" class="list-group-item list-group-item-action"><%= descricao _%></a>
        <%_ } _%>
        </ul>
      <%_ } else { _%>
        Sem grupos de visualização cadastrados
      <%_ } _%>
    </div>
  </div>
</div>
<br><br><br>
<%- include('../../partials/jsinclude.ejs') _%>

<script src="/js/base.cli.js" defer></script>

<%- include('../../partials/footer.ejs') _%>