<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css" integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2" crossorigin="anonymous"> -->
  <style>
    a{
      text-decoration: none;
      color: black;
      border: 1px solid black;
      border-radius: 20px;
    }
    .logo{
      text-align: center;
    }
    .titulo{
      font-size: large;
      font-weight: bold;
    }
    .info{
      text-align: justify;
      font-size: 17px;
      margin-right: 2rem;
    }
    #btnP{
      background-color: rgba(201, 191, 191, 0.938);
      padding: 2px 15px;
    }
  </style>
</head>
<body>
  <main style="margin: 6px; padding: 2px">
    <img src="" width="120px">
    <span class="titulo">
      <%= emailTitulo _%>
    </span>
    <p class="info">
      <%- emailConteudo _%>
    </p>
    <p>
      <%= emailSolicitante _%>
    </p>
    <%_ if(linkImpressao) { _%> 
      <a href="<%= linkImpressao _%>"id="btnP">Visualizar</a>
    <%_ } _%>
  </main>
</body>
</html>